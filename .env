# The bundled eslint-config-react-app/jest preset references a jest env that the
# resolved eslint-plugin-jest version does not register, which breaks
# `react-scripts build` (both locally and on Amplify). Type-checking still runs
# via Babel; code style is enforced in the editor. Disabling only the CRA
# build-time ESLint plugin keeps deploys deterministic.
DISABLE_ESLINT_PLUGIN=true
ESLINT_NO_DEV_ERRORS=true
